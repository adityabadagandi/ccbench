{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CCBenchCase",
  "type": "object",
  "required": [
    "case_id",
    "bucket",
    "jurisdiction",
    "documents",
    "question",
    "gold_answer",
    "gold_facts",
    "gold_label"
  ],
  "properties": {
    "case_id": {"type": "string", "pattern": "^ccbench-[0-9]{4}$"},
    "bucket": {
      "enum": ["lookup", "multi-hop", "temporal", "cross-lingual", "compliance"]
    },
    "jurisdiction": {"enum": ["IN", "EU"]},
    "documents": {
      "type": "object",
      "required": ["invoice", "erp_order"],
      "properties": {
        "invoice": {"$ref": "#/definitions/invoice"},
        "eway_bill": {"oneOf": [{"$ref": "#/definitions/eway_bill"}, {"type": "null"}]},
        "erp_order": {"$ref": "#/definitions/erp_order"},
        "whatsapp_pod": {"oneOf": [{"$ref": "#/definitions/whatsapp_pod"}, {"type": "null"}]},
        "flag": {"type": ["object", "null"]}
      }
    },
    "question": {"type": "string", "minLength": 1},
    "gold_answer": {"type": "string", "minLength": 1},
    "gold_facts": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "minItems": 1
    },
    "gold_label": {
      "enum": [
        "clean",
        "value_mismatch",
        "missing_ewb",
        "temporal_violation",
        "compliance_case"
      ]
    },
    "difficulty": {"enum": ["easy", "medium", "hard"]},
    "must_not_appear": {
      "type": "array",
      "items": {"type": "string"},
      "default": []
    }
  },
  "definitions": {
    "invoice": {
      "type": "object",
      "required": [
        "invoice_no", "date", "seller", "buyer", "items",
        "total_taxable_value", "total_cgst", "total_sgst", "invoice_total",
        "vehicle_no", "consignment_ref"
      ],
      "properties": {
        "invoice_no": {"type": "string"},
        "date": {"type": "string", "format": "date"},
        "seller": {"$ref": "#/definitions/party"},
        "buyer": {"$ref": "#/definitions/party"},
        "items": {
          "type": "array",
          "items": {"$ref": "#/definitions/invoice_item"},
          "minItems": 1
        },
        "total_taxable_value": {"type": "number", "minimum": 0},
        "total_cgst": {"type": "number", "minimum": 0},
        "total_sgst": {"type": "number", "minimum": 0},
        "invoice_total": {"type": "number", "minimum": 0},
        "eway_bill_ref": {"type": ["string", "null"]},
        "vehicle_no": {"type": "string"},
        "consignment_ref": {"type": "string"}
      }
    },
    "party": {
      "type": "object",
      "required": ["name", "gstin", "address"],
      "properties": {
        "name": {"type": "string"},
        "gstin": {"type": "string", "pattern": "^[0-9]{2}[A-Z]{5}[0-9]{4}[A-Z][0-9A-Z]{2}$"},
        "address": {"type": "string"}
      }
    },
    "invoice_item": {
      "type": "object",
      "required": [
        "description", "hsn_code", "quantity", "unit",
        "rate_per_unit", "taxable_value", "cgst_rate", "sgst_rate",
        "cgst_amount", "sgst_amount"
      ],
      "properties": {
        "description": {"type": "string"},
        "hsn_code": {"type": "string"},
        "quantity": {"type": "number", "minimum": 1},
        "unit": {"type": "string"},
        "rate_per_unit": {"type": "number", "minimum": 0},
        "taxable_value": {"type": "number", "minimum": 0},
        "cgst_rate": {"type": "number"},
        "sgst_rate": {"type": "number"},
        "cgst_amount": {"type": "number", "minimum": 0},
        "sgst_amount": {"type": "number", "minimum": 0}
      }
    },
    "eway_bill": {
      "type": "object",
      "required": [
        "ewb_no", "generation_date", "valid_until",
        "from_gstin", "from_address", "to_gstin", "to_address",
        "transporter", "vehicle_no", "consignment_ref",
        "items", "total_value", "distance_km"
      ],
      "properties": {
        "ewb_no": {"type": "string"},
        "generation_date": {"type": "string", "format": "date-time"},
        "valid_until": {"type": "string", "format": "date-time"},
        "from_gstin": {"type": "string"},
        "from_address": {"type": "string"},
        "to_gstin": {"type": "string"},
        "to_address": {"type": "string"},
        "transporter": {"type": "string"},
        "vehicle_no": {"type": "string"},
        "consignment_ref": {"type": "string"},
        "items": {
          "type": "array",
          "items": {"$ref": "#/definitions/eway_item"},
          "minItems": 1
        },
        "total_value": {"type": "number", "minimum": 0},
        "distance_km": {"type": "number", "minimum": 0}
      }
    },
    "eway_item": {
      "type": "object",
      "required": ["description", "hsn_code", "quantity", "unit"],
      "properties": {
        "description": {"type": "string"},
        "hsn_code": {"type": "string"},
        "quantity": {"type": "number", "minimum": 1},
        "unit": {"type": "string"}
      }
    },
    "erp_order": {
      "type": "object",
      "required": [
        "po_no", "po_date", "buyer", "vendor_code", "vendor_name",
        "items", "po_total", "payment_terms", "status",
        "invoice_refs", "consignment_ref"
      ],
      "properties": {
        "po_no": {"type": "string"},
        "po_date": {"type": "string", "format": "date"},
        "buyer": {"type": "string"},
        "vendor_code": {"type": "string"},
        "vendor_name": {"type": "string"},
        "items": {
          "type": "array",
          "items": {"$ref": "#/definitions/erp_item"},
          "minItems": 1
        },
        "po_total": {"type": "number", "minimum": 0},
        "payment_terms": {"type": "string"},
        "status": {"enum": ["fulfilled", "partially_fulfilled", "pending"]},
        "invoice_refs": {"type": "array", "items": {"type": "string"}},
        "consignment_ref": {"type": "string"}
      }
    },
    "erp_item": {
      "type": "object",
      "required": [
        "item_code", "description", "quantity_ordered", "unit",
        "unit_price", "total_value", "expected_delivery"
      ],
      "properties": {
        "item_code": {"type": "string"},
        "description": {"type": "string"},
        "quantity_ordered": {"type": "number", "minimum": 1},
        "unit": {"type": "string"},
        "unit_price": {"type": "number", "minimum": 0},
        "total_value": {"type": "number", "minimum": 0},
        "expected_delivery": {"type": "string", "format": "date"}
      }
    },
    "whatsapp_pod": {
      "type": "object",
      "required": ["thread_id", "driver_name", "driver_phone", "messages"],
      "properties": {
        "thread_id": {"type": "string"},
        "driver_name": {"type": "string"},
        "driver_phone": {"type": "string"},
        "messages": {
          "type": "array",
          "items": {"$ref": "#/definitions/message"}
        },
        "delivery_confirmed": {"type": "boolean"},
        "pod_signed_by": {"type": "string"}
      }
    },
    "message": {
      "type": "object",
      "required": ["timestamp", "sender", "text"],
      "properties": {
        "timestamp": {"type": "string", "format": "date-time"},
        "sender": {"type": "string"},
        "text": {"type": "string"}
      }
    }
  }
}
